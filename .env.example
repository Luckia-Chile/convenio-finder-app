# Copia este archivo a .env.local y completa los valores. NUNCA subas .env.local a git.
# Las variables VITE_* se incrustan al compilar: son visibles en el navegador.
# Usa SOLO la anon key. La service_role jamás va aquí.

# Supabase (self-hosted): URL pública de Kong y ANON_KEY de la instancia
VITE_SUPABASE_URL=http://convenios.intranet.arica
VITE_SUPABASE_ANON_KEY=

# Opcionales
# VITE_LOG_LEVEL=debug          # debug | info (por defecto info)
# VITE_MAX_FILE_SIZE=52428800   # tope recomendado del Excel en bytes (por defecto 50 MB)
